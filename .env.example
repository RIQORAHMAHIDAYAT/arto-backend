# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://arto:arto_secret@localhost:5432/arto"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret-32chars"
JWT_ACCESS_TTL="15m"
# Refresh token bersifat opaque random, di-hash SHA-256, dan disimpan di DB —
# tidak memerlukan secret terpisah.
JWT_REFRESH_TTL_DAYS=30

# Seeding (dev only — otomatis diblokir saat NODE_ENV=production)
# SEED_DEMO_EMAIL=demo@arto.id
# SEED_DEMO_PASSWORD=demopass123
# SEED_ADMIN_EMAIL=admin@arto.id
# SEED_ADMIN_PASSWORD=adminpass123
# SEED_SUPERADMIN_EMAIL=superadmin@arto.id
# SEED_SUPERADMIN_PASSWORD=superpass123

# CORS (comma separated). "*" untuk semua origin.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
